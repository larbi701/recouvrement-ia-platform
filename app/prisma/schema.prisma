generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Client {
  id                String    @id @default(cuid())
  name              String
  sector            String
  contactName       String
  contactEmail      String
  contactPhone      String    @default("")
  behaviorNote      String // note de contexte utilisée par l'agent (ex: "client fiable, retard exceptionnel")
  strategic         Boolean   @default(false)
  chronicLatePayer  Boolean   @default(false) // ignore les emails -> l'agent saute direct au canal WhatsApp
  invoices          Invoice[]
  createdAt         DateTime  @default(now())
}

model Invoice {
  id            String     @id @default(cuid())
  client        Client     @relation(fields: [clientId], references: [id])
  clientId      String
  reference     String
  amountMad     Int
  issueDate     DateTime
  dueDate       DateTime
  status        String     // EN_COURS | EN_RETARD | LITIGE | ECHEANCIER | PAYEE
  reminders     Reminder[]
  replies       ClientReply[]
  callTasks     CallTask[]
  promises      PromiseToPay[]
  createdAt     DateTime   @default(now())
}

model PromiseToPay {
  id            String    @id @default(cuid())
  invoice       Invoice   @relation(fields: [invoiceId], references: [id])
  invoiceId     String
  amountMad     Int
  promisedDate  DateTime
  status        String    @default("EN_COURS") // EN_COURS | TENUE | ROMPUE
  source        String    // APPEL | REPONSE | MANUEL
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?
}

model Reminder {
  id          String   @id @default(cuid())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  invoiceId   String
  channel     String   @default("EMAIL") // EMAIL | WHATSAPP
  tone        String   // AMICALE | FERME | MISE_EN_DEMEURE
  content     String
  status      String   // BROUILLON | ENVOYEE_SIMULEE
  createdBy   String   // AGENT | HUMAIN
  sentAt      DateTime @default(now())
}

model CallTask {
  id             String    @id @default(cuid())
  invoice        Invoice   @relation(fields: [invoiceId], references: [id])
  invoiceId      String
  reason         String // pourquoi cet appel est proposé (ex: "client stratégique, premier retard")
  talkingPoints  String // fiche d'appel générée par l'agent
  status         String    @default("A_FAIRE") // A_FAIRE | FAIT
  outcome        String? // PROMESSE_PAIEMENT | NE_REPOND_PAS | CONTESTE | PAYE | AUTRE
  outcomeNote    String?
  promisedDate   DateTime?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
}

model ClientReply {
  id               String   @id @default(cuid())
  invoice          Invoice  @relation(fields: [invoiceId], references: [id])
  invoiceId        String
  content          String
  classifiedIntent String?  // DEMANDE_DELAI | CONTESTATION | CONFIRMATION | AUTRE
  agentSummary     String?
  proposedAction   String?
  receivedAt       DateTime @default(now())
}
